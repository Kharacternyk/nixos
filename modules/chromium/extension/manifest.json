{
  "manifest_version": 3,
  "name": "Local keyboard browser",
  "version": "0.1.0",
  "description": "Local qutebrowser-style navigation.",
  "permissions": [
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "open": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the start page in a new window"
    }
  },
  "key": ""
}
